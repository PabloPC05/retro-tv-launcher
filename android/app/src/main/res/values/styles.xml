<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />

    <!-- Icon-only pill: a 42dp circle (pill_bg's 21dp corners) with the 22dp icon centred by even padding. Give it a
         contentDescription, since there is no text. -->
    <style name="TopButtonIcon" parent="TopButtonBase">
        <item name="android:layout_width">42dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/settings_choice_bg</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SettingsColumnChoice" parent="SettingsRow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:gravity">center</item>
    </style>
    <!-- AlertDialogs (launcher settings) in the glass_style win98 / xp / 8bit skins. -->
    <style name="W98Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/w98_raised</item>
        <item name="android:fontFamily">@font/skin_w98</item>
        <item name="android:colorBackground">#FFC0C0C0</item>
        <item name="android:textColorPrimary">#FF000000</item>
        <item name="android:textColorSecondary">#FF000000</item>
        <item name="android:textColorAlertDialogListItem">#FF000000</item>
        <item name="android:colorAccent">#FF000080</item>
        <item name="android:colorControlActivated">#FF000080</item>
    </style>
    <style name="XpDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/xp_raised</item>
        <item name="android:fontFamily">@font/skin_xp</item>
        <item name="android:colorBackground">#FFF5F4EE</item>
        <item name="android:textColorPrimary">#FF000000</item>
        <item name="android:textColorSecondary">#FF333333</item>
        <item name="android:textColorAlertDialogListItem">#FF000000</item>
        <item name="android:colorAccent">#FF316AC5</item>
        <item name="android:colorControlActivated">#FF21A121</item>
    </style>
    <style name="BitDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bit_raised</item>
        <item name="android:fontFamily">@font/skin_pix</item>
        <item name="android:colorBackground">#FF0000A8</item>
        <item name="android:textColorPrimary">#FFFCFCFC</item>
        <item name="android:textColorSecondary">#FFFCFCFC</item>
        <item name="android:textColorAlertDialogListItem">#FFFCFCFC</item>
        <item name="android:colorAccent">#FFFCE020</item>
        <item name="android:colorControlActivated">#FFFCE020</item>
    </style>
</resources>