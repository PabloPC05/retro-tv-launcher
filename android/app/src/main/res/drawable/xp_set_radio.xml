<?xml version="1.0" encoding="utf-8"?>
<!-- Win98 option button: white sunken circle, black dot when chosen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:width="22dp" android:height="22dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF"/>
                    <stroke android:width="2dp" android:color="#FF1C5180"/>
                    <size android:width="22dp" android:height="22dp"/>
                </shape>
            </item>
            <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
                <shape android:shape="oval"><solid android:color="#FF21A121"/></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF"/>
            <stroke android:width="2dp" android:color="#FF1C5180"/>
            <size android:width="22dp" android:height="22dp"/>
        </shape>
    </item>
</selector>
