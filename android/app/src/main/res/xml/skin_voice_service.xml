<?xml version="1.0" encoding="utf-8"?>
<!-- SkinVoiceService: reads only the Google assistant's search screen, to catch "Windows 98", "Frutiger Aero" or
     "8 bits" said through the remote's mic. No key filtering, no gestures. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewTextChanged"
    android:packageNames="com.google.android.katniss"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="150"
    android:canRetrieveWindowContent="true"
    android:accessibilityFlags="flagDefault"
    android:description="@string/skin_voice_description" />
